{
  "name": "the-letter-home",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-assets.mjs && next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "assets": "node scripts/check-assets.mjs",
    "looks": "node scripts/prepare-looks.mjs",
    "test:production": "node tests/run-production.mjs",
    "test:performance": "node tests/run-production.mjs --lighthouse",
    "test:integration": "node tests/live-integration.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "axe-core": "4.14.1",
    "lighthouse": "13.6.0"
  }
}
